cd ~/Documents/Projects/Azentio-Hackathon-2026
cat > .gitignore <<'EOF'
# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride
._*

# ---------- Frontend: Next.js / Node ----------
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Testing / coverage
coverage/
.nyc_output/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel
.vercel

# ---------- Backend: Java / Spring Boot ----------
# Maven
target/
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar

# Gradle
.gradle/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Compiled files
*.class
*.log
*.pid
hs_err_pid*

# Packaged artifacts
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar

# Local Spring config with secrets
application-local.properties
application-local.yml
application-local.yaml
application-dev.properties
application-dev.yml

# ---------- Secrets / environment (both) ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Logs ----------
logs/
*.log

# ---------- IDEs ----------
# VS Code (keep shared settings, ignore the rest)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# Eclipse / Spring Tool Suite
.classpath
.project
.settings/
.factorypath
.apt_generated/
.springBeans
.sts4-cache/
bin/

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ---------- Misc ----------
*.swp
*.swo
*~
tmp/
temp/
EOF